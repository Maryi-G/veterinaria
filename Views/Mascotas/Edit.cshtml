@model Veterinaria.Models.Mascota
@{
    Layout = "_Layout";
}

<h2>Editar Mascota</h2>

<form asp-action="Edit" method="post">

    <!-- 🔴 ESTO ES OBLIGATORIO -->
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="form-group">
        <label>Edad</label>
        <input asp-for="Edad" class="form-control" />
    </div>

    <div class="form-group">
        <label>Especie</label>
        <input asp-for="Especie" class="form-control" />
    </div>

    <div class="form-group">
        <label>Raza</label>
        <input asp-for="Raza" class="form-control" />
    </div>

    <div class="form-group">
        <label>Género</label>
        <input asp-for="Genero" class="form-control" />
    </div>

    <div class="form-group">
        <label>Color</label>
        <input asp-for="Color" class="form-control" />
    </div>

    <button class="btn btn-success mt-3">Guardar cambios</button>
</form>
