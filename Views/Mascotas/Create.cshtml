@model Veterinaria.Models.Mascota

<h2>Registrar Mascota</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Edad</label>
        <input asp-for="Edad" type="number" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Especie</label>
        <input asp-for="Especie" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Raza</label>
        <input asp-for="Raza" class="form-control" />
    </div>

    <div class="form-group">
        <label>Género</label>
        <select asp-for="Genero" class="form-control" required>
            <option value="">Seleccione</option>
            <option>Macho</option>
            <option>Hembra</option>
        </select>
    </div>

    <div class="form-group">
        <label>Color</label>
        <input asp-for="Color" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success mt-3">
        Guardar
    </button>

</form>
