@{
    Layout = "_Layout";
    ViewData["Title"] = "Registro";
}
    

<div class="row justify-content-center">
    <div class="col-12 d-flex justify-content-center align-items-center"
         style="min-height: calc(100vh - 140px);">

        <div class="card shadow-lg border-0 rounded-4"
             style="width: 380px;">

            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <h4 class="fw-bold text-primary">🐾 Veterinaria</h4>
                    <p class="text-muted mb-0">Crear cuenta</p>
                </div>

                <form asp-action="Register" method="post">

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="Email" type="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input name="Password" type="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confirmar contraseña</label>
                        <input name="ConfirmPassword" type="password" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Registrarse
                    </button>

                    <div class="text-center mt-3">
                        <small>
                            ¿Ya tienes cuenta?
                            <a asp-action="Login">Iniciar sesión</a>
                        </small>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3 text-center">
                            @ViewBag.Error
                        </div>
                    }

                </form>

            </div>
        </div>
    </div>
</div>
